   "source": [
    "# гистограмма и в ней мы считаем, сколько раз встречается каждая оценка, и сортируем по возрастанию\n",
    "quality_counts = q.value_counts().sort_index()\n",
    "\n",
    "plt.figure(figsize=(9, 5))\n",
    "\n",
    "plt.bar(\n",
    "    quality_counts.index,\n",
